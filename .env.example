# ── OpenAI (gpt-5-mini / text-embedding-3-small) ──
# 없으면 오프라인 목 모드로 전 구간 동작. 실제 데모 시 입력 권장.
OPENAI_API_KEY=

# ── 네이버 데이터랩 검색어 트렌드 [전민재] ──
# 없으면 mock 트렌드로 폴백. 발급: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── API 키 인증(FastAPI) ──
# 콤마로 여러 개 가능. 비우면 인증 비활성(개발 편의).
# 아래 API_KEY(프론트가 헤더로 보낼 값)는 이 목록 중 하나와 반드시 일치해야 함.
API_KEYS=demo-key-12345
API_KEY=demo-key-12345

# ── DB 파일 경로(선택, 기본 backend/app.db) ──
DB_PATH=

# 참고: 백엔드 CORS는 현재 allow_origins=["*"](POC 편의). 실제 배포 시
# main.py 를 실제 Streamlit 주소로 좁히세요(강의 Ch12.6).
