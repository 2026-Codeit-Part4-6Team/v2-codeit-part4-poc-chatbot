# 실행에 불필요한 캐시
__pycache__/
*.pyc
.git/
.gitignore

# 비밀값: 절대 이미지에 굽지 않는다(Ch8.4 / Ch12 원칙)
.env

# 로컬 DB: 컨테이너에선 startup 시 init_db()가 테이블을 새로 만든다.
#   운영 데이터는 compose의 Bind Mount(./backend:/app)로 호스트에 영속.
app.db
smoke_test.db

# 생성 산출물/평가 캐시(이미지·db 등)는 이미지에 넣지 않음
output/*.png
eval/__pycache__/

# ⚠ data/*.json(벤치마크 KB·리뷰 샘플)은 제외하면 안 됨 → RAG가 참조하므로 이미지에 포함되어야 함
